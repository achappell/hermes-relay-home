// Ship the Home local JSONL export (safe events and client reports) to Loki.
//
// Validated with Grafana Alloy v1.20.1 (`alloy fmt` leaves it unchanged and
// `alloy validate` passes). It uses `sys.env`, because the bare `env` function
// is deprecated in that release and fails validation.
//
// Status: see the deployment section of
// _bmad-output/implementation-artifacts/validation-home-nw-06-diagnostics-exporter.md.
// Applying it is an owner-approved host step, not part of the Home package.
//
// The local JSONL files remain the source of truth; this shipper only reads
// them. Run Alloy as a service account that can read the export directory only
// (for example NT SERVICE\Alloy with Read & Execute on that directory, never on
// its parents or on `secrets\`). Set HERMES_HOME_LOKI_PUSH_URL in that
// service's environment, for example
// http://ops.taila59979.ts.net:3100/loki/api/v1/push. The household Loki has no
// authentication and no tenant (auth_enabled is off), so the endpoint block has
// neither; if ops enables them, add `tenant_id` or `basic_auth` there with the
// secret in a service environment variable, never in this file.
//
// Loki receives line ingestion time. Only `job`, `host` and `record_type`
// become labels. Device, report, launch and correlation identifiers stay in
// the log line body and must never be promoted to labels. If Alloy's data
// directory (positions) is wiped, existing export files are ingested again and
// their lines duplicate in Loki.

local.file_match "hermes_home_export" {
	path_targets = [
		{
			"__path__" = "C:/ProgramData/HermesHome/diagnostics/export/safe-events.*.jsonl",
			"job"      = "hermes-home-export",
			"host"     = "caticornqueen",
		},
		{
			"__path__" = "C:/ProgramData/HermesHome/diagnostics/export/client-reports.*.jsonl",
			"job"      = "hermes-home-export",
			"host"     = "caticornqueen",
		},
	]
	sync_period = "15s"
}

loki.source.file "hermes_home_export" {
	targets    = local.file_match.hermes_home_export.targets
	forward_to = [loki.process.hermes_home_export.receiver]
}

loki.process "hermes_home_export" {
	forward_to = [loki.write.household.receiver]

	stage.json {
		expressions = {record_type = "record_type"}
	}

	stage.labels {
		values = {record_type = ""}
	}
}

loki.write "household" {
	endpoint {
		url = sys.env("HERMES_HOME_LOKI_PUSH_URL")
	}
}
