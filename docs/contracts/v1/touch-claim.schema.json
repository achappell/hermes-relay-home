{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.home/contracts/v1/touch-claim.schema.json",
  "title": "Hermes Home touch claim",
  "type": "object",
  "required": [
    "schema",
    "claim_id",
    "device_id",
    "configuration_revision",
    "initiation"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 1},
    "claim_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "configuration_revision": {"type": "integer", "minimum": 0},
    "initiation": {
      "type": "object",
      "required": ["kind", "observed_at_ms"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "tap"},
        "observed_at_ms": {"type": "integer", "minimum": 0}
      }
    }
  }
}
