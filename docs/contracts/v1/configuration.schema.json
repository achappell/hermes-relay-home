{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.home/contracts/v1/configuration.schema.json",
  "title": "Hermes Home configuration snapshot",
  "type": "object",
  "required": ["revision", "rooms", "profiles", "wake_mappings", "devices"],
  "additionalProperties": false,
  "properties": {
    "revision": {"type": "integer", "minimum": 0},
    "rooms": {
      "type": "array",
      "items": {"$ref": "#/$defs/room"}
    },
    "profiles": {
      "type": "array",
      "items": {"$ref": "#/$defs/profile"}
    },
    "wake_mappings": {
      "type": "array",
      "items": {"$ref": "#/$defs/wake_mapping"}
    },
    "devices": {
      "type": "array",
      "items": {"$ref": "#/$defs/device"},
      "contains": {
        "type": "object",
        "required": ["wake_admission"]
      },
      "minContains": 0,
      "maxContains": 1,
      "description": "At most one explicit paired-room approval. Approval mappings must be active and reference available Profiles; Home validates these cross-record references."
    },
    "client_devices": {
      "type": "array",
      "items": {"$ref": "#/$defs/client_device"},
      "description": "Paired personal-client Devices (credential scope client_claim) that an administrator allows to answer typed choices. Omission denies. An ID must not also appear in devices."
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "room": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "profile": {
      "type": "object",
      "required": ["id", "name", "available"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "available": {"type": "boolean"},
        "shared": {"type": "boolean"}
      }
    },
    "wake_mapping": {
      "type": "object",
      "required": ["id", "phrase", "profile_id", "active"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "phrase": {"type": "string", "minLength": 1, "maxLength": 128},
        "profile_id": {"$ref": "#/$defs/id"},
        "active": {"type": "boolean"}
      }
    },
    "device": {
      "type": "object",
      "required": ["id", "name", "room_id", "priority", "capabilities"],
      "additionalProperties": false,
      "dependentSchemas": {
        "wake_admission": {
          "properties": {
            "capabilities": {
              "properties": {"wake_claim": {"const": true}}
            }
          }
        }
      },
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "room_id": {"$ref": "#/$defs/id"},
        "priority": {"type": "integer", "minimum": 1},
        "wake_admission": {"$ref": "#/$defs/wake_admission"},
        "capabilities": {
          "type": "object",
          "required": ["wake_claim"],
          "additionalProperties": false,
          "properties": {
            "wake_claim": {"type": "boolean"},
            "interactive_choice": {
              "type": "boolean",
              "default": false,
              "description": "Explicitly permits this Device to answer typed choice prompts. Omission denies choice actions."
            },
            "sensitive_entry": {
              "type": "boolean",
              "default": false,
              "description": "Explicitly permits this Device to submit one current Sensitive Entry value. Omission denies secret and sudo entry."
            },
            "consequence_confirm": {
              "type": "boolean",
              "default": false,
              "description": "Explicitly permits this Device to confirm a current consequence-bearing approval. Omission denies approval actions."
            }
          }
        }
      }
    },
    "wake_admission": {
      "type": "object",
      "required": ["mode", "endpoint_id", "wake_mapping_ids"],
      "additionalProperties": false,
      "properties": {
        "mode": {"const": "paired_room"},
        "endpoint_id": {"$ref": "#/$defs/id"},
        "wake_mapping_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      },
      "description": "Explicit approval bound to this Device's current Room and durable credential endpoint. Omission preserves strict wake admission."
    },
    "client_device": {
      "type": "object",
      "required": ["id", "capabilities"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "capabilities": {
          "type": "object",
          "required": ["interactive_choice"],
          "additionalProperties": false,
          "properties": {
            "interactive_choice": {
              "type": "boolean",
              "description": "Explicitly permits this paired client to answer typed choice prompts. Omission or false denies."
            }
          }
        }
      }
    }
  }
}
