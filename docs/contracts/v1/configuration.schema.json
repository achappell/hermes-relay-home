{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.home/contracts/v1/configuration.schema.json",
  "title": "Hermes Home configuration snapshot",
  "type": "object",
  "required": ["revision", "rooms", "profiles", "wake_mappings", "devices"],
  "additionalProperties": false,
  "properties": {
    "revision": {"type": "integer", "minimum": 0},
    "rooms": {
      "type": "array",
      "items": {"$ref": "#/$defs/room"}
    },
    "profiles": {
      "type": "array",
      "items": {"$ref": "#/$defs/profile"}
    },
    "wake_mappings": {
      "type": "array",
      "items": {"$ref": "#/$defs/wake_mapping"}
    },
    "devices": {
      "type": "array",
      "items": {"$ref": "#/$defs/device"}
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "room": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "profile": {
      "type": "object",
      "required": ["id", "name", "available"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "available": {"type": "boolean"}
      }
    },
    "wake_mapping": {
      "type": "object",
      "required": ["id", "phrase", "profile_id", "active"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "phrase": {"type": "string", "minLength": 1, "maxLength": 128},
        "profile_id": {"$ref": "#/$defs/id"},
        "active": {"type": "boolean"}
      }
    },
    "device": {
      "type": "object",
      "required": ["id", "name", "room_id", "priority", "capabilities"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "room_id": {"$ref": "#/$defs/id"},
        "priority": {"type": "integer", "minimum": 1},
        "capabilities": {
          "type": "object",
          "required": ["wake_claim"],
          "additionalProperties": false,
          "properties": {
            "wake_claim": {"type": "boolean"},
            "interactive_choice": {
              "type": "boolean",
              "default": false,
              "description": "Explicitly permits this Device to answer typed choice prompts. Omission denies choice actions."
            },
            "sensitive_entry": {
              "type": "boolean",
              "default": false,
              "description": "Explicitly permits this Device to submit one current Sensitive Entry value. Omission denies secret and sudo entry."
            },
            "consequence_confirm": {
              "type": "boolean",
              "default": false,
              "description": "Explicitly permits this Device to confirm a current consequence-bearing approval. Omission denies approval actions."
            }
          }
        }
      }
    }
  }
}
